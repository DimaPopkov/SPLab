# Единый стандарт переносов строк LF для всех текстовых файлов
* text=auto eol=lf

# Конфиги инфраструктуры, скрипты и код
Makefile text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Бинарные файлы и дампы
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.dump binary
*.tar binary
*.gz binary
*.zip binary
